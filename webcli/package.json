{
  "name": "weworker-webcli",
  "version": "1.0.0",
  "description": "Browser automation CLI for Extension and Toolkit Adapters",
  "type": "module",
  "main": "index.js",
  "bin": {
    "webcli": "index.js"
  },
  "files": [
    "index.js",
    "bridge.js",
    "metrics.js",
    "stats.js",
    "adapter-cli.js",
    "adapter-registry.js",
    "toolkit-runner.js",
    "direct-execution-metadata.js",
    "adapter-scaffold.js",
    "ai-analyzer.js",
    "ai-worker.js",
    "ai-worker-session.js",
    "generation-worker.js",
    "generation-worker-controller.js",
    "generation-transport.js",
    "generation-harness/",
    "skill-installer.js",
    "skill-writer.js",
    "logger.js",
    "config/",
    "generated/",
    "open-browser-policy.js",
    "paths.js",
    "websocket-origin-policy.js",
    "tool-timeouts.js",
    "install.js",
    "skills/",
    "extension/"
  ],
  "scripts": {
    "start": "node index.js",
    "install-host": "node install.js",
    "prepack": "node scripts/prepare-package-extension.js",
    "generate:adapters": "node scripts/generate-adapters.js --profile public",
    "generate:wecli-adapters": "node scripts/generate-wecli-adapters.js --profile public",
    "test": "vitest --run",
    "test:ci": "vitest --run --testTimeout=20000",
    "test:e2e:real": "node scripts/run-real-e2e.js --profile public",
    "test:api:inventory": "vitest --run __tests__/api-adapter-certification.test.js",
    "test:api:evidence": "vitest --run __tests__/api-adapter-test-evidence.test.js",
    "test:api:runtime": "cd .. && node --test extension/test/api-adapter-runtime-registration.test.mjs",
    "test:api:safety": "cd .. && node --test extension/test/api-adapter-confirmation-guards.test.mjs",
    "test:api:success": "cd .. && node --test extension/test/api-adapter-success-smoke.test.mjs",
    "test:api:failure": "cd .. && node --test extension/test/api-adapter-failure-smoke.test.mjs",
    "test:api:common-errors": "cd .. && node --test extension/test/api-adapter-common-errors.test.mjs",
    "test:api:mock": "cd .. && node --test extension/test/api-adapter-runtime-registration.test.mjs extension/test/api-adapter-success-smoke.test.mjs extension/test/api-adapter-failure-smoke.test.mjs extension/test/api-adapter-confirmation-guards.test.mjs extension/test/api-adapter-common-errors.test.mjs",
    "certify:api:inventory": "node api-adapter-certification.js",
    "certify:api:evidence": "node api-adapter-test-evidence.js --certification-only",
    "certify:api:evidence:all": "node api-adapter-test-evidence.js",
    "certify:api:matrix": "node api-adapter-certification-matrix.js --output=../artifacts/api-adapter-certification/certification-matrix.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "ws": "^8.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "fast-check": "^4.7.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  }
}
