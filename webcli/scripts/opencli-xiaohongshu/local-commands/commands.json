[
  {
    "id": "albums",
    "runtime": "extension",
    "module": "extension/commands/albums.js",
    "routeDomain": "www.xiaohongshu.com",
    "description": "读取当前用户或指定用户的收藏专辑列表（页面加载与有限滚动，返回完整性）",
    "safety": "read",
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": []
    }
  },
  {
    "id": "album-notes",
    "runtime": "extension",
    "module": "extension/commands/album-notes.js",
    "routeDomain": "www.xiaohongshu.com",
    "description": "读取收藏专辑笔记及视频类型，返回分页完整性",
    "safety": "read",
    "schema": {
      "type": "object",
      "properties": {
        "album-id": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "album-id"
      ]
    }
  },
  {
    "id": "video-media",
    "runtime": "extension",
    "module": "extension/commands/video-media.js",
    "routeDomain": "www.xiaohongshu.com",
    "description": "读取笔记的带音轨 MP4 媒体地址，供本地下载使用",
    "safety": "read",
    "schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url"
      ]
    }
  }
]
