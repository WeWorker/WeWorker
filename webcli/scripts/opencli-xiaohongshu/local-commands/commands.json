[
  {
    "id": "albums",
    "runtime": "extension",
    "module": "extension/commands/albums.js",
    "routeDomain": "www.xiaohongshu.com",
    "description": "读取当前用户或指定用户的收藏专辑列表（页面加载与有限滚动，返回完整性）",
    "safety": "read",
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": []
    },
    "results": [
      {
        "itemsPath": "albums",
        "idField": "id",
        "titleField": "name",
        "actions": [
          {
            "id": "detail",
            "label": "查看专辑笔记",
            "command": "album-notes",
            "args": { "album-id": { "from": "item.id" } }
          }
        ]
      }
    ]
  },
  {
    "id": "album-notes",
    "runtime": "extension",
    "module": "extension/commands/album-notes.js",
    "routeDomain": "www.xiaohongshu.com",
    "description": "读取收藏专辑笔记及视频类型，返回分页完整性",
    "safety": "read",
    "schema": {
      "type": "object",
      "properties": {
        "album-id": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "album-id"
      ]
    },
    "results": [
      {
        "itemsPath": "notes",
        "idField": "id",
        "titleField": "title",
        "actions": [
          {
            "id": "detail",
            "label": "查看笔记",
            "command": "note",
            "args": { "note-id": { "from": "item.url" } }
          }
        ]
      }
    ]
  },
  {
    "id": "video-media",
    "runtime": "extension",
    "module": "extension/commands/video-media.js",
    "routeDomain": "www.xiaohongshu.com",
    "description": "读取笔记的带音轨 MP4 媒体地址，供本地下载使用",
    "safety": "read",
    "schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url"
      ]
    },
    "results": [
      {
        "actions": [],
        "reason": "返回带音轨的媒体流地址及规格，供独立的本地下载步骤使用；媒体流不是笔记对象，不提供笔记修改操作。"
      }
    ]
  }
]
