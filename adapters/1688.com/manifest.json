{
  "schema_version": 2,
  "name": "1688.com",
  "version": "0.1.1",
  "enabled": true,
  "description": "1688 批发：商品搜索、商品/店铺详情、素材提取和登录检查",
  "homepage_url": "https://www.1688.com/",
  "match": [
    "1688.com",
    "www.1688.com",
    "login.1688.com",
    "login.taobao.com",
    "account.1688.com",
    "s.1688.com",
    "detail.1688.com",
    "detail.m.1688.com",
    "winport.m.1688.com",
    "*.1688.com"
  ],
  "requires_auth": false,
  "discovery_terms": [
    "1688",
    "1688 批发"
  ],
  "runtime_allowed_hosts": [
    "1688.com",
    "www.1688.com",
    "login.1688.com",
    "login.taobao.com",
    "account.1688.com",
    "s.1688.com",
    "detail.1688.com",
    "detail.m.1688.com",
    "winport.m.1688.com"
  ],
  "auth": {
    "login_url": "https://login.1688.com/member/signin.htm",
    "login_hosts": [
      "login.1688.com",
      "login.taobao.com",
      "account.1688.com"
    ],
    "check": {
      "cookies": {
        "url": "https://www.1688.com/",
        "equals": {
          "__cn_logon__": "true"
        }
      }
    }
  },
  "scenarios": [
    {
      "id": "product-search",
      "title": "搜索商品",
      "summary": "按关键词搜索 1688 商品，返回候选商品、卖家链接、价格、起订量和销量文本",
      "tool_names": [
        "search"
      ]
    },
    {
      "id": "product-detail",
      "title": "查看商品详情",
      "summary": "读取 1688 商品公开字段、价格阶梯和卖家基础信息",
      "tool_names": [
        "item"
      ]
    },
    {
      "id": "store-info",
      "title": "查看店铺信息",
      "summary": "读取 1688 店铺或供应商公开信息、主营内容和服务信号",
      "tool_names": [
        "store"
      ]
    },
    {
      "id": "product-assets",
      "title": "提取商品素材",
      "summary": "列出商品页可提取的图片和视频素材 URL 与文件名",
      "tool_names": [
        "assets",
        "download"
      ]
    }
  ],
  "commands": [
    {
      "id": "assets",
      "runtime": "extension",
      "module": "extension/commands/assets.js",
      "routeDomain": "www.1688.com",
      "description": "列出 1688 商品页可提取的图片/视频素材",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "1688 商品 URL 或 offer ID（如 887904326744）"
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "itemsPath": "$",
          "idField": "offer_id",
          "titleField": "display_title",
          "actions": [
            {
              "id": "detail",
              "label": "查看详情",
              "command": "item",
              "args": {
                "input": {
                  "from": "item.item_url"
                }
              }
            },
            {
              "id": "download",
              "label": "列出下载链接",
              "command": "download",
              "args": {
                "input": {
                  "from": "item.item_url"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "whoami",
      "runtime": "extension",
      "module": "extension/commands/whoami.js",
      "routeDomain": "1688.com",
      "description": "Show the current logged-in 1688 account",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "results": [
        {
          "actions": [],
          "reason": "Returns authenticated account identity only. There is no account-detail, purchase-history or account-edit command; public product search is an independent query."
        }
      ]
    },
    {
      "id": "login",
      "runtime": "extension",
      "module": "extension/commands/login.js",
      "routeDomain": "1688.com",
      "description": "Open the 1688 login page; finish signing in on the page, then verify with whoami",
      "safety": "write",
      "schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "download",
      "runtime": "extension",
      "module": "extension/commands/download.js",
      "routeDomain": "www.1688.com",
      "description": "列出 1688 商品页可提取的图片和视频素材（URL 与文件名，不落盘）",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "1688 商品 URL 或 offer ID（如 887904326744）"
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "actions": [],
          "reason": "Returns media URLs and suggested filenames only. No command in this package saves a media file or opens an individual media asset; download-to-disk requires a separate capability."
        }
      ]
    },
    {
      "id": "item",
      "runtime": "extension",
      "module": "extension/commands/item.js",
      "routeDomain": "www.1688.com",
      "description": "1688 商品详情（公开商品字段、价格阶梯、卖家基础信息）",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "1688 商品 URL 或 offer ID（如 887904326744）"
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "itemsPath": "$",
          "idField": "offer_id",
          "titleField": "display_title",
          "actions": [
            {
              "id": "assets",
              "label": "查看素材",
              "command": "assets",
              "args": {
                "input": {
                  "from": "item.item_url"
                }
              }
            },
            {
              "id": "download",
              "label": "列出下载链接",
              "command": "download",
              "args": {
                "input": {
                  "from": "item.item_url"
                }
              }
            },
            {
              "id": "store",
              "label": "查看店铺",
              "command": "store",
              "args": {
                "input": {
                  "from": "item.seller_url"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "search",
      "runtime": "extension",
      "module": "extension/commands/search.js",
      "routeDomain": "www.1688.com",
      "description": "1688 商品搜索（结果候选、卖家链接、价格/MOQ/销量文本）",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "搜索关键词，如 \"置物架\""
          },
          "limit": {
            "type": "integer",
            "description": "结果数量上限（默认 20，最大 100）",
            "default": 20
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "itemsPath": "$",
          "idField": "item_url",
          "titleField": "display_title",
          "actions": [
            {
              "id": "detail",
              "label": "查看详情",
              "command": "item",
              "args": {
                "input": {
                  "from": "item.item_url"
                }
              }
            },
            {
              "id": "assets",
              "label": "查看素材",
              "command": "assets",
              "args": {
                "input": {
                  "from": "item.item_url"
                }
              }
            },
            {
              "id": "download",
              "label": "列出下载链接",
              "command": "download",
              "args": {
                "input": {
                  "from": "item.item_url"
                }
              }
            },
            {
              "id": "store",
              "label": "查看店铺",
              "command": "store",
              "args": {
                "input": {
                  "from": "item.seller_url"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "store",
      "runtime": "extension",
      "module": "extension/commands/store.js",
      "routeDomain": "www.1688.com",
      "description": "1688 店铺/供应商公开信息（联系方式、主营、入驻年限、公开服务信号）",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "1688 店铺 URL 或 member ID（如 b2b-22154705262941f196）"
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "actions": [],
          "reason": "Returns supplier profile and contact fields. This package has no shop-scoped product listing or contact-seller operation; keyword search cannot represent shop inventory."
        }
      ]
    }
  ]
}
