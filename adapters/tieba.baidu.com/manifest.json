{
  "schema_version": 2,
  "name": "tieba.baidu.com",
  "version": "0.1.0",
  "enabled": true,
  "description": "百度贴吧：热议话题、帖子搜索、吧内帖子和主题阅读",
  "match": [
    "tieba.baidu.com"
  ],
  "requires_auth": false,
  "discovery_terms": [
    "tieba",
    "百度贴吧"
  ],
  "scenarios": [
    {
      "id": "hot-topics",
      "title": "查看热议话题",
      "summary": "读取百度贴吧热议话题",
      "tool_names": [
        "hot"
      ]
    },
    {
      "id": "post-search",
      "title": "搜索帖子",
      "summary": "跨贴吧搜索帖子",
      "tool_names": [
        "search"
      ]
    },
    {
      "id": "forum-posts",
      "title": "浏览吧内帖子",
      "summary": "浏览指定贴吧的帖子列表",
      "tool_names": [
        "posts"
      ]
    },
    {
      "id": "thread-read",
      "title": "阅读主题",
      "summary": "读取贴吧主题帖内容",
      "tool_names": [
        "read"
      ]
    }
  ],
  "commands": [
    {
      "id": "hot",
      "runtime": "extension",
      "module": "extension/commands/hot.js",
      "routeDomain": "tieba.baidu.com",
      "description": "Tieba hot topics",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Number of items to return",
            "default": 20
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "results": [
        {
          "itemsPath": "$",
          "idField": "url",
          "titleField": "title",
          "actions": [
            {
              "id": "detail",
              "label": "搜索相关帖子",
              "command": "search",
              "args": {
                "keyword": {
                  "from": "item.title"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "posts",
      "runtime": "extension",
      "module": "extension/commands/posts.js",
      "routeDomain": "tieba.baidu.com",
      "description": "Browse posts in a tieba forum",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "forum": {
            "type": "string",
            "description": "Forum name in Chinese"
          },
          "page": {
            "type": "integer",
            "description": "Page number",
            "default": 1
          },
          "limit": {
            "type": "integer",
            "description": "Number of items to return",
            "default": 20
          }
        },
        "required": [
          "forum"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "itemsPath": "$",
          "idField": "id",
          "titleField": "title",
          "actions": [
            {
              "id": "detail",
              "label": "查看帖子",
              "command": "read",
              "args": {
                "id": {
                  "from": "item.id"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "read",
      "runtime": "extension",
      "module": "extension/commands/read.js",
      "routeDomain": "tieba.baidu.com",
      "description": "Read a tieba thread",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Thread ID"
          },
          "page": {
            "type": "integer",
            "description": "Page number",
            "default": 1
          },
          "limit": {
            "type": "integer",
            "description": "Number of replies to return",
            "default": 30
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "actions": [],
          "reason": "返回当前主题页的正文和回复；现有 Adapter 无单条回复详情、作者或回复写操作。翻页使用 read 的显式 page 参数。"
        }
      ]
    },
    {
      "id": "search",
      "runtime": "extension",
      "module": "extension/commands/search.js",
      "routeDomain": "tieba.baidu.com",
      "description": "Search posts across tieba",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "Search keyword"
          },
          "page": {
            "type": "integer",
            "description": "Page number (currently only 1 is supported)",
            "default": 1
          },
          "limit": {
            "type": "integer",
            "description": "Number of items to return",
            "default": 20
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "itemsPath": "$",
          "idField": "id",
          "titleField": "title",
          "actions": [
            {
              "id": "detail",
              "label": "查看帖子",
              "command": "read",
              "args": {
                "id": {
                  "from": "item.id"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
