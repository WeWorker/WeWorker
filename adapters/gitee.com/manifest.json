{
  "schema_version": 2,
  "name": "gitee.com",
  "version": "0.1.1",
  "enabled": true,
  "description": "Gitee：仓库搜索、推荐项目、用户资料和登录检查",
  "homepage_url": "https://gitee.com/",
  "match": [
    "gitee.com",
    "www.gitee.com"
  ],
  "requires_auth": false,
  "discovery_terms": [
    "gitee",
    "Gitee 代码托管"
  ],
  "runtime_allowed_hosts": [
    "gitee.com",
    "www.gitee.com",
    "so.gitee.com"
  ],
  "auth": {
    "login_url": "https://gitee.com/login",
    "check": {
      "command": "whoami"
    }
  },
  "scenarios": [
    {
      "id": "repo-search",
      "title": "搜索仓库",
      "summary": "按关键词搜索 Gitee 仓库",
      "tool_names": [
        "search"
      ]
    },
    {
      "id": "trending-projects",
      "title": "查看推荐项目",
      "summary": "读取 Gitee Explore 推荐开源项目",
      "tool_names": [
        "trending"
      ]
    },
    {
      "id": "user-profile",
      "title": "查看用户资料",
      "summary": "读取 Gitee 用户资料面板",
      "tool_names": [
        "user"
      ]
    },
    {
      "id": "login-status",
      "title": "登录检查",
      "summary": "打开登录页并检查当前 Gitee 登录身份",
      "tool_names": [
        "whoami",
        "login"
      ]
    }
  ],
  "commands": [
    {
      "id": "search",
      "runtime": "extension",
      "module": "extension/commands/search.js",
      "routeDomain": "gitee.com",
      "description": "Search repositories on Gitee",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "Search keyword"
          },
          "limit": {
            "type": "integer",
            "description": "Number of results (max 50)",
            "default": 10
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "itemsPath": "$",
          "idField": "url",
          "titleField": "name",
          "actions": [
            {
              "id": "owner",
              "label": "查看所有者",
              "command": "user",
              "args": {
                "username": {
                  "from": "item.owner"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "trending",
      "runtime": "extension",
      "module": "extension/commands/trending.js",
      "routeDomain": "gitee.com",
      "description": "Recommended open-source projects on Gitee Explore",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Number of projects (max 50)",
            "default": 20
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "results": [
        {
          "itemsPath": "$",
          "idField": "url",
          "titleField": "name",
          "actions": [
            {
              "id": "owner",
              "label": "查看所有者",
              "command": "user",
              "args": {
                "username": {
                  "from": "item.owner"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "user",
      "runtime": "extension",
      "module": "extension/commands/user.js",
      "routeDomain": "gitee.com",
      "description": "Show a Gitee user profile panel",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Gitee username"
          }
        },
        "required": [
          "username"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "actions": [],
          "reason": "Profile metrics are terminal in this package; there is no username-scoped repository list, follower list or account-edit command. Keyword repository search is not an owner-scoped list."
        }
      ]
    },
    {
      "id": "whoami",
      "runtime": "extension",
      "module": "extension/commands/whoami.js",
      "routeDomain": "gitee.com",
      "description": "Show the current logged-in gitee account",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "results": [
        {
          "itemPath": "$",
          "idField": "user_id",
          "titleField": "username",
          "actions": [
            {
              "id": "detail",
              "label": "查看资料",
              "command": "user",
              "args": {
                "username": {
                  "from": "item.username"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "login",
      "runtime": "extension",
      "module": "extension/commands/login.js",
      "routeDomain": "gitee.com",
      "description": "Open the gitee login page; finish signing in on the page, then verify with whoami",
      "safety": "write",
      "schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  ]
}
