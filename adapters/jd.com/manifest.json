{
  "schema_version": 2,
  "name": "jd.com",
  "version": "1.0.13",
  "enabled": true,
  "description": "京东：导航主页、查看购物车、查看订单、购买商品、支付",
  "match": [
    "www.jd.com"
  ],
  "domains": [
    "jd.com",
    "jd.hk"
  ],
  "auth": {
    "login_url": "https://passport.jd.com/new/login.aspx",
    "login_hosts": [
      "passport.jd.com",
      "aq.jd.com"
    ],
    "check": {
      "command": "check-login-status"
    },
    "qr": {
      "command": "get-login-qrcode"
    }
  },
  "requires_auth": true,
  "commands": [
    {
      "id": "check-login-status",
      "runtime": "extension",
      "module": "extension/commands/check-login-status.js",
      "description": "检测京东是否已登录并返回登录状态。仅在用户明确询问登录状态时调用；调用其他工具前无需先调用它，未登录时 WeWorker 会自动打开登录页并在登录后继续。",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "aliases": [
        "check_login_status"
      ],
      "excludeTabDomain": "pc-settlement-lite-pro.pf.jd.com",
      "results": [
        {
          "actions": [],
          "reason": "Host login/navigation diagnostic only; not a selectable business result."
        }
      ]
    },
    {
      "id": "get-login-qrcode",
      "runtime": "extension",
      "module": "extension/commands/get-login-qrcode.js",
      "description": "提取京东登录页的二维码图片（宿主登录流程专用，不作为业务工具调用）。",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "results": [
        {
          "actions": [],
          "reason": "Host login/navigation diagnostic only; not a selectable business result."
        }
      ]
    },
    {
      "id": "search-products",
      "runtime": "extension",
      "module": "extension/commands/search-products.js",
      "description": "按关键词搜索京东商品，一次调用返回商品列表（SKU、标题、价格、原价、店铺、销量、图片、链接）。",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "Search keyword (e.g., \"耳机\", \"笔记本电脑\", \"运动鞋\")"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "description": "最多返回的商品数，默认 30"
          }
        },
        "required": [
          "keyword"
        ]
      },
      "aliases": [
        "search_products"
      ],
      "excludeTabDomain": "pc-settlement-lite-pro.pf.jd.com",
      "results": [
        {
          "itemsPath": "$.products",
          "idField": "sku",
          "titleField": "title",
          "actions": [
            {
              "id": "detail",
              "label": "查看商品详情",
              "command": "open-product",
              "args": {
                "sku": {
                  "from": "item.sku"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "navigate-to-homepage",
      "runtime": "extension",
      "module": "extension/commands/navigate-to-homepage.js",
      "description": "打开京东首页，页面加载完成后返回。其他工具会自行打开所需页面，通常不需要先调用它。",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "aliases": [
        "navigate_to_homepage"
      ],
      "excludeTabDomain": "pc-settlement-lite-pro.pf.jd.com",
      "results": [
        {
          "actions": [],
          "reason": "Host login/navigation diagnostic only; not a selectable business result."
        }
      ]
    },
    {
      "id": "view-cart",
      "runtime": "extension",
      "module": "extension/commands/view-cart.js",
      "description": "查看京东购物车，一次调用返回商品列表（名称、SKU、单价、数量、是否勾选、规格、店铺）和已勾选商品的估算金额 selectedEstimate（单价×数量，不含结算时的优惠）。",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "aliases": [
        "view_cart"
      ],
      "excludeTabDomain": "pc-settlement-lite-pro.pf.jd.com",
      "results": [
        {
          "itemsPath": "$.items",
          "idField": "sku",
          "titleField": "name",
          "actions": [
            {
              "id": "detail",
              "label": "查看商品详情",
              "command": "open-product",
              "args": {
                "sku": {
                  "from": "item.sku"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "view-orders",
      "runtime": "extension",
      "module": "extension/commands/view-orders.js",
      "description": "查看京东「我的订单」（订单号、下单时间、店铺、商品、金额、状态；拆分订单含子订单），并给出合计 summary.totalAmount（不含已取消订单）。统计某段时间的消费时传 since（如本月第一天），会自动翻页直到更早的订单；complete 为 false 表示还有未读的页。页面默认只列近 3 个月的订单。一次调用即可返回；未登录时 WeWorker 会自动打开登录页。",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "只返回该日期（含）之后的订单，格式 YYYY-MM-DD，例如 2026-10-01；会自动翻页"
          },
          "maxPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "最多读取的页数，默认 1（传 since 时默认 10）"
          }
        },
        "required": []
      },
      "aliases": [
        "view_orders"
      ],
      "excludeTabDomain": "pc-settlement-lite-pro.pf.jd.com",
      "routeDomain": "order.jd.com",
      "results": [
        {
          "actions": [],
          "reason": "Order records are terminal: no order-detail, cancellation or selected-order payment command. Product details are nested and must not be guessed from an order ID."
        }
      ]
    },
    {
      "id": "open-product",
      "runtime": "extension",
      "module": "extension/commands/open-product.js",
      "description": "打开京东商品页，页面加载完成后返回（不需要额外等待）。传 url 或 sku 之一。",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Product page URL (e.g., https://item.jd.com/100054010576.html)"
          },
          "sku": {
            "type": "string",
            "description": "商品 SKU（搜索结果中的 sku），与 url 二选一",
            "minLength": 1
          }
        },
        "required": []
      },
      "aliases": [
        "open_product"
      ],
      "excludeTabDomain": "pc-settlement-lite-pro.pf.jd.com",
      "results": [
        {
          "itemPath": "$",
          "idField": "sku",
          "titleField": "productUrl",
          "actions": [
            {
              "id": "buy",
              "label": "立即购买",
              "command": "buy-now",
              "args": {
                "sku": {
                  "from": "item.sku"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "buy-now",
      "runtime": "extension",
      "module": "extension/commands/buy-now.js",
      "description": "在当前商品页点击该商品的「立即购买」，并打开京东结算页（此时尚未下单、未支付）。需先用 jd.com.open-product 打开商品页；商品需要预约、到货通知或先选规格时会返回页面上的按钮说明。完成后用 jd.com.pay-now 支付。 传 sku 时校验当前商品身份，页面切换后拒绝点击。",
      "safety": "write",
      "schema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "description": "Expected selected SKU; reject before clicking if the current product page differs."
          }
        },
        "required": []
      },
      "aliases": [
        "buy_now"
      ],
      "excludeTabDomain": "pc-settlement-lite-pro.pf.jd.com"
    },
    {
      "id": "pay-now",
      "runtime": "extension",
      "module": "extension/commands/pay-now.js",
      "description": "Select payment method and click \"立即支付\" (Pay Now) button on the JD.com checkout confirmation page. Must be called after buy_now when the settlement page is open.",
      "safety": "write",
      "schema": {
        "type": "object",
        "properties": {
          "paymentMethod": {
            "type": "string",
            "description": "Payment method to use. Options: \"京东支付\", \"京东白条\", \"微信支付\", \"云闪付\", \"APP支付\"",
            "enum": [
              "京东支付",
              "京东白条",
              "微信支付",
              "云闪付",
              "APP支付"
            ]
          }
        },
        "required": [
          "paymentMethod"
        ]
      },
      "aliases": [
        "pay_now"
      ],
      "tabDomain": "pc-settlement-lite-pro.pf.jd.com"
    }
  ],
  "homepage_url": "https://www.jd.com/",
  "icon": "cart",
  "scenarios": [
    {
      "id": "navigate-home",
      "title": "导航主页",
      "summary": "打开京东主页并进入可操作状态"
    },
    {
      "id": "search-product",
      "title": "搜索商品",
      "summary": "在京东中搜索商品"
    },
    {
      "id": "view-cart",
      "title": "查看购物车",
      "summary": "在京东中查看购物车"
    },
    {
      "id": "view-order",
      "route": {
        "direct": false,
        "reason": "消费金额依赖登录态页面数据，无直调只读命令可承接"
      },
      "title": "查看订单",
      "summary": "帮我看看我这个月在京东消费了多少钱",
      "prompts": [
        {
          "text": "帮我看看我${这个月}在京东消费了多少钱"
        }
      ]
    },
    {
      "id": "buy-product",
      "route": {
        "direct": false,
        "reason": "写操作（下单），不得进路由面"
      },
      "title": "购买商品",
      "summary": "帮我在京东再买一个我之前买过的牙膏",
      "prompts": [
        {
          "text": "帮我在京东再买一个我之前买过的${牙膏}"
        }
      ]
    },
    {
      "id": "pay-order",
      "route": {
        "direct": false,
        "reason": "写操作（支付），不得进路由面"
      },
      "title": "支付",
      "summary": "在京东中确认订单后完成支付流程",
      "prompts": [
        {
          "text": "帮我在京东再买一个我之前买过的${牙膏}"
        }
      ]
    }
  ],
  "test_prompts": [
    "打开京东，查看我的订单列表，然后查看购物车，再搜索'牙膏'并告诉我搜索结果"
  ],
  "i18n": {
    "zh": {
      "name": "京东",
      "description": "京东：导航主页、查看购物车、查看订单、购买商品、支付"
    }
  },
  "verified_on": "2026-03-16"
}
