{
  "schema_version": 2,
  "name": "note.youdao.com",
  "version": "0.1.1",
  "enabled": true,
  "description": "有道云笔记公开分享全文与摘要读取",
  "match": [
    "share.note.youdao.com",
    "note.youdao.com",
    "share.note.youdao.cn",
    "note.youdao.cn"
  ],
  "requires_auth": false,
  "discovery_terms": [
    "有道云笔记",
    "有道笔记",
    "youdao"
  ],
  "commands": [
    {
      "id": "note",
      "runtime": "extension",
      "module": "extension/commands/note.js",
      "routeDomain": "share.note.youdao.com",
      "description": "Read a public shared Youdao Note",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Full share URL of the Youdao Note"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "actions": [],
          "reason": "Returns public shared-note text, summary and keywords. This package has no per-block, attachment, edit or delete operation; share URL resolution remains part of this read."
        }
      ]
    }
  ]
}
