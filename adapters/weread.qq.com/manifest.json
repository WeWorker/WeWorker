{
  "schema_version": 2,
  "name": "weread.qq.com",
  "version": "0.1.1",
  "enabled": true,
  "description": "微信读书：书籍搜索/详情、书架、划线笔记、排行榜和登录检查",
  "homepage_url": "https://weread.qq.com/",
  "match": [
    "weread.qq.com",
    "i.weread.qq.com"
  ],
  "requires_auth": false,
  "discovery_terms": [
    "weread",
    "微信读书"
  ],
  "runtime_allowed_hosts": [
    "weread.qq.com",
    "i.weread.qq.com"
  ],
  "auth": {
    "login_url": "https://weread.qq.com/",
    "check": {
      "command": "whoami"
    }
  },
  "scenarios": [
    {
      "id": "book-search",
      "title": "搜索和查看书籍",
      "summary": "搜索微信读书书籍，读取书籍详情，并在书内搜索内容",
      "tool_names": [
        "search",
        "book",
        "book-search"
      ]
    },
    {
      "id": "shelf-and-ranking",
      "title": "书架和排行榜",
      "summary": "读取个人书架和微信读书排行榜",
      "tool_names": [
        "shelf",
        "ranking"
      ]
    },
    {
      "id": "notes-and-highlights",
      "title": "划线和笔记",
      "summary": "读取有划线或笔记的书籍、书中划线和想法",
      "tool_names": [
        "notebooks",
        "highlights",
        "notes"
      ]
    },
    {
      "id": "book-outline",
      "title": "AI 大纲",
      "summary": "读取书籍的 AI 生成大纲",
      "tool_names": [
        "ai-outline"
      ]
    }
  ],
  "commands": [
    {
      "id": "ai-outline",
      "runtime": "extension",
      "module": "extension/commands/ai-outline.js",
      "routeDomain": "weread.qq.com",
      "description": "Get AI-generated outline for a book",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "book-id": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Book ID (from shelf or search results)"
          },
          "limit": {
            "type": "integer",
            "description": "Max outline items to return",
            "default": 200
          },
          "depth": {
            "type": "integer",
            "description": "Max outline depth (2=topics, 3=key points, 4=details)",
            "default": 4
          },
          "raw": {
            "type": "boolean",
            "description": "Output structured rows (chapter/idx/level/text) for programmatic use",
            "default": false
          }
        },
        "required": [
          "book-id"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "actions": [],
          "reason": "返回大纲正文或结构化大纲行；当前包没有章节正文读取或大纲节点操作命令。"
        }
      ]
    },
    {
      "id": "whoami",
      "runtime": "extension",
      "module": "extension/commands/whoami.js",
      "routeDomain": "weread.qq.com",
      "description": "Show the current logged-in weread account",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "results": [
        {
          "itemPath": "$",
          "idField": "user_id",
          "titleField": "name",
          "actions": [
            {
              "id": "detail",
              "label": "查看书架",
              "command": "shelf",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "id": "login",
      "runtime": "extension",
      "module": "extension/commands/login.js",
      "routeDomain": "weread.qq.com",
      "description": "Open the weread login page; finish signing in on the page, then verify with whoami",
      "safety": "write",
      "schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "book",
      "runtime": "extension",
      "module": "extension/commands/book.js",
      "routeDomain": "weread.qq.com",
      "description": "View book details on WeRead",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "book-id": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Book ID from search or shelf results"
          }
        },
        "required": [
          "book-id"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "itemsPath": "$",
          "idField": "bookId",
          "titleField": "title",
          "actions": [
            {
              "id": "detail",
              "label": "查看笔记",
              "command": "notes",
              "args": {
                "book-id": {
                  "from": "item.bookId"
                }
              }
            },
            {
              "id": "highlights",
              "label": "查看划线",
              "command": "highlights",
              "args": {
                "book-id": {
                  "from": "item.bookId"
                }
              }
            },
            {
              "id": "outline",
              "label": "查看大纲",
              "command": "ai-outline",
              "args": {
                "book-id": {
                  "from": "item.bookId"
                }
              }
            },
            {
              "id": "search",
              "label": "书内搜索",
              "command": "book-search",
              "args": {
                "book": {
                  "from": "item.bookId"
                }
              },
              "inputs": [
                "query"
              ]
            },
            {
              "id": "book",
              "label": "查看书籍",
              "command": "book",
              "args": {
                "book-id": {
                  "from": "item.bookId"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "book-search",
      "runtime": "extension",
      "module": "extension/commands/book-search.js",
      "routeDomain": "weread.qq.com",
      "description": "Search within a WeRead book after resolving it by title",
      "safety": "read",
      "execution": {
        "type": "api",
        "runtime": "background"
      },
      "schema": {
        "type": "object",
        "properties": {
          "book": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Book title keyword, numeric bookId, or reader URL"
          },
          "query": {
            "type": "string",
            "description": "Keyword to search inside the selected book"
          },
          "book-rank": {
            "type": "integer",
            "description": "Which book search result to use when book is a title keyword",
            "default": 1
          },
          "limit": {
            "type": "integer",
            "description": "Max in-book matches to return (1-100)",
            "default": 20
          },
          "fragment-size": {
            "type": "integer",
            "description": "Snippet length around each match (1-500)",
            "default": 150
          },
          "raw": {
            "type": "boolean",
            "description": "Output structured rows instead of markdown text",
            "default": false
          }
        },
        "required": [
          "book",
          "query"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "actions": [],
          "reason": "返回书内命中片段；当前包没有按章节或命中位置读取正文的命令，不把片段当作全文。"
        }
      ]
    },
