{
  "schema_version": 2,
  "name": "smzdm.com",
  "version": "0.1.0",
  "enabled": true,
  "description": "什么值得买：搜索好价内容",
  "match": [
    "smzdm.com",
    "www.smzdm.com",
    "search.smzdm.com",
    "post.smzdm.com"
  ],
  "requires_auth": false,
  "discovery_terms": [
    "smzdm",
    "什么值得买"
  ],
  "scenarios": [
    {
      "id": "deal-search",
      "title": "搜索好价",
      "summary": "按关键词搜索什么值得买好价内容",
      "tool_names": [
        "search"
      ]
    }
  ],
  "commands": [
    {
      "id": "search",
      "runtime": "extension",
      "module": "extension/commands/search.js",
      "routeDomain": "search.smzdm.com",
      "description": "什么值得买搜索好价",
      "safety": "read",
      "schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search keyword"
          },
          "limit": {
            "type": "integer",
            "description": "Number of results",
            "default": 20
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "actions": [],
          "reason": "This package contains only search. Result links cannot become detail, comment, purchase or save actions until those Adapter commands exist."
        }
      ]
    }
  ]
}
