{
  "name": "weworker-backend",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "start": "node --experimental-sqlite src/server.ts",
    "dev": "tsx --experimental-sqlite src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:ci": "vitest --run --testTimeout=15000",
    "test": "vitest --run",
    "route:replay": "tsx scripts/route-replay.mts",
    "route:replay:live": "tsx scripts/route-replay.mts --live"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.252",
    "@anthropic-ai/claude-code": "2.1.252",
    "@anthropic-ai/sdk": "0.122.0",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "express": "^4.19.2",
    "node-cron": "^4.2.1",
    "sm-crypto": "^0.4.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "yauzl": "2.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@emnapi/runtime": "1.11.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.12",
    "@types/yazl": "3.3.1",
    "fast-check": "^4.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0",
    "yazl": "2.5.1"
  }
}
