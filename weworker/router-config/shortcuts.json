/* 公共快捷入口：无参只允许枚举的完整句子全等；带参只允许锚定模板与受限槽值。
 * negative 优先，抽参失败不派发；级联层另有 adapter 名称门。
 * 每条 examples 是完整正例，参数槽值必须与工具 schema 一致。
 */
{
  "shortcuts": {
    "v2ex.com": [
      {
        "id": "v2ex-hot", "tool": "v2ex.com.hot", "priority": 20,
        "patterns": { "exact": ["v2ex 热门", "v2ex 热榜", "v2ex 最热", "v2ex 热帖", "v2ex 热门话题"], "negative": ["哪个|哪些|怎么|为什么|如何|是否"] },
        "args": { "limit": 20 }, "render": { "type": "schema", "schemaId": "v2ex-topic-list" }, "examples": ["v2ex 热门"]
      },
      {
        "id": "v2ex-latest", "tool": "v2ex.com.latest", "priority": 20,
        "patterns": { "exact": ["v2ex 最新", "v2ex 最新话题", "v2ex 最新帖子", "v2ex 最新主题"], "negative": ["哪个|哪些|怎么|为什么|如何|是否"] },
        "args": { "limit": 20 }, "render": { "type": "schema", "schemaId": "v2ex-topic-list" }, "examples": ["v2ex 最新"]
      },
      {
        "id": "v2ex-nodes", "tool": "v2ex.com.nodes", "priority": 30,
        "patterns": { "exact": ["v2ex 节点列表", "v2ex 全部节点", "v2ex 所有节点", "v2ex nodes"], "negative": ["哪个|哪些|怎么|为什么|如何|是否"] },
        "args": { "limit": 50 }, "render": { "type": "schema", "schemaId": "v2ex-node-list" }, "examples": ["v2ex nodes"]
      },
      {
        "id": "v2ex-topic", "tool": "v2ex.com.topic", "priority": 20,
        "patterns": {
          "positive": ["^v2ex(?:\\s+|\\s*[:#/]\\s*)[1-9]\\d{0,8}$", "^v2ex\\s+(?:主题|帖子|话题|topic)(?:\\s+|\\s*[:#/]\\s*)[1-9]\\d{0,8}$"],
          "negative": ["列表|排行|哪个|哪些|怎么|为什么|如何|是否"]
        },
        "extract": [{ "from": "message", "regex": "^v2ex(?:\\s+(?:主题|帖子|话题|topic))?(?:\\s+|\\s*[:#/]\\s*)([1-9]\\d{0,8})$", "flags": "i", "arg": "id", "type": "integer", "min": 1, "max": 999999999 }],
        "examples": ["v2ex 主题 12345", "v2ex 987"]
      },
      {
        "id": "v2ex-member", "tool": "v2ex.com.member", "priority": 20,
        "patterns": { "positive": ["^v2ex\\s+(?:用户|会员|member)\\s*[:：]?\\s*@?[A-Za-z0-9_-]{1,30}$"], "negative": ["哪个|哪些|怎么|为什么|如何|是否|功能"] },
        "extract": [{ "from": "message", "regex": "^v2ex\\s+(?:用户|会员|member)\\s*[:：]?\\s*@?([A-Za-z0-9_-]{1,30})$", "flags": "i", "arg": "username", "type": "string" }],
        "examples": ["v2ex 用户 example_user"]
      },
      {
        "id": "v2ex-node", "tool": "v2ex.com.node", "priority": 10,
        "patterns": { "positive": ["^v2ex\\s+(?:节点|node)\\s*[:：]?\\s*[A-Za-z0-9_-]{1,30}$"], "negative": ["节点列表|全部节点|所有节点|\\bnodes\\b|哪个|哪些|怎么|为什么|如何|是否"] },
        "args": { "limit": 20 },
        "extract": [{ "from": "message", "regex": "^v2ex\\s+(?:节点|node)\\s*[:：]?\\s*([A-Za-z0-9_-]{1,30})$", "flags": "i", "arg": "name", "type": "string" }],
        "render": { "type": "schema", "schemaId": "v2ex-node-topics" }, "examples": ["v2ex 节点 python"]
      }
    ],
    "github.com": [
      {
        "id": "github-trending", "tool": "github.com.repos", "priority": 10,
        "patterns": { "exact": ["github trending", "github 热榜", "github 趋势榜", "github 趋势", "github 热门仓库", "github 热门项目", "github 热门", "github 排行"], "negative": ["仓库信息|这个仓库|某仓库|哪个|哪些|怎么|为什么|如何|是否"] },
        "args": { "since": "daily", "limit": 25 }, "examples": ["github trending", "github 热门仓库"]
      }
    ],
    "arxiv.org": [
      {
        "id": "arxiv-search", "tool": "arxiv.org.search", "priority": 20,
        "patterns": { "positive": ["^arxiv\\s+搜索\\s+[A-Za-z0-9][A-Za-z0-9 _+.#-]{0,79}$", "^帮我在\\s+arxiv\\s+上搜索\\s+[A-Za-z0-9][A-Za-z0-9 _+.#-]{0,79}\\s+相关论文$"], "negative": ["哪个|哪些|怎么|为什么|如何|是否|然后|并且|顺便|接着|同时|再(?:帮|查|搜|看|分析|总结)|\\b(?:then|and|also)\\b"] },
        "args": { "limit": 20 },
        "extract": [{ "from": "message", "regex": "^(?:arxiv\\s+搜索\\s+|帮我在\\s+arxiv\\s+上搜索\\s+)([A-Za-z0-9][A-Za-z0-9 _+.#-]{0,79}?)(?:\\s+相关论文)?$", "flags": "i", "arg": "query", "type": "string" }],
        "render": { "type": "schema", "schemaId": "arxiv-papers" }, "examples": ["arxiv 搜索 transformer", "帮我在 arxiv 上搜索 RAG 相关论文"]
      },
      {
        "id": "arxiv-paper", "tool": "arxiv.org.paper", "priority": 30,
        "patterns": { "positive": ["^arxiv\\s+(?:论文\\s*)?\\d{4}\\.\\d{4,5}(?:v[1-9]\\d{0,2})?$"], "negative": ["哪个|哪些|怎么|为什么|如何|是否"] },
        "extract": [{ "from": "message", "regex": "^arxiv\\s+(?:论文\\s*)?(\\d{4}\\.\\d{4,5}(?:v[1-9]\\d{0,2})?)$", "flags": "i", "arg": "id", "type": "string" }],
        "examples": ["arxiv 2401.12345"]
      }
    ]
  }
}
