/* ═══════════════════════════════════════════════════════════════════════════
 * patterns.json —— 第 8 层（Tier -1）：提示词配置层（全句模板 + 负向 + 抽参）
 *
 * 【本层负责什么】
 *   在**没有 adapter 关键词硬门**的情况下，使用全句字面模板认领消息，再抽出参数直连工具。
 *   模板中的 `${query}` 等是唯一可变槽位；其他字符（包括空格、冒号、计量单位）按字面匹配。
 *   普通 regex/keyword 只能用于不含槽位的全等枚举。命中后失败策略是 stop（不再往下猜）。
 *
 * 【怎么写：两层 key 定位】
 *   1. `configs` 的第一层 key 是 **adapter id**（`"wikipedia.org"`）——按站点分节，
 *      「这个 adapter 配了什么」一眼可见，新增 adapter 时该插在哪里也是确定的；
 *   2. 第二层 key 是 **完整工具名**（`"<adapterId>.<工具名>"`，必须与 catalog 里的工具名逐字
 *      一致，且属只读可直调工具）。保留完整名字而不是缩写成 `search`：key 与工具名字面一致，
 *      grep / jq / 既有用户覆盖层与外部注入配置都不用改。
 *   → 「工具名前缀 = 所属 adapter」这条关系由校验器强制：写进别的站的分节会被当场拦下。
 *
 * 【每条配置的字段】
 *   - `patterns[]`：全句字面模板规则，**每条规则都要有 `examples`**（必填）；
 *   - `negative_patterns`：整条配置的否决词（任一命中即放弃本条）；
 *   - `arg_extractors`：同名模板槽直接捕获参数并沿用 type/min/max；旧 regex 留作兼容；
 *   - `default_args`：本条默认参数，会被抽取结果覆盖。
 *
 * 【一条完整成功示例】
 *   "configs": {
 *     "wikipedia.org": {
 *       "wikipedia.org.search": {
 *         "priority": 20,
 *         "patterns": [{ "type": "template",
 *                        "expression": "维基百科搜索 ${query}",
 *                        "weight": 1,
 *                        "default_args": { "lang": "zh", "limit": 10 },
 *                        "examples": ["维基百科搜索 量子力学"] }],
 *         "negative_patterns": ["正文|全文|页面内容|搜索引擎|搜索功能"],
 *         "arg_extractors": [{ "regex": "(?:搜索|查找)(?:\\s+|[:：])\\s*(\\S[\\s\\S]{0,60})$",
 *                              "arg": "query", "type": "string" }]
 *       }
 *     }
 *   }
 *   → 输入「维基百科搜索 量子力学」：命中规则 → 抽 query=量子力学 → 调 wikipedia.org.search。
 *   → 输入「维基百科搜索功能怎么用」：负向词「搜索功能」命中 → 本条放弃，落回 LLM。
 *
 * 【旧形态仍兼容】
 *   直接写 `{ "<完整工具名>": { … } }`（不分节）继续可用，外部注入配置与历史覆盖层不受影响；
 *   两种形态还可以逐条混写。但新增配置请用分节形态，便于回答「这个 adapter 配了什么」。
 *
 * 【常见的写坏方式（都会被当场拦下 / 被负例集打红）】
 *   ✗ 模板写成「维基百科搜索${query}」漏掉分隔空格 → 把「搜索引擎」当检索词。
 *   ✗ 漏写 `negative_patterns` → 讨论态问句可能被当成查询请求。
 *   ✗ 槽名与真实工具参数名不符，或把计量单位/固定语句写入槽位。
 *   ✗ 缺 `examples`：本层每条规则都必须有——写对了没有，拿例子实跑才知道。
 *   ✗ 同一条模板被两条不同工具共用 → 先命中者赢，另一条永远拿不到。
 *   ✗ 条目放进别的 adapter 的分节（或把分节写到了文件顶层，少了 `configs`）→ 报错并回退该层。
 *
 * 【本层不放什么】
 *   ✗ 消息里必然带站点名的话术 → 放 shortcuts.json（那边有 adapter 硬门，更安全更快）
 *   ✗ 写操作工具 → 只读准入会丢弃
 *   ✗ 未经明确指定固定句式的自由语言检索 → 落回 LLM，避免模板吞掉别的意图
 * ═══════════════════════════════════════════════════════════════════════════ */
{
  "version": "1",
  "global": {
    "case_sensitive": false,
    "min_confidence_for_match": 0.8
  },
  "configs": {
    // ── wikipedia.org ────────────────────────────────────────────────────────
    "wikipedia.org": {
      "wikipedia.org.search": {
        "priority": 20,
        "patterns": [
          {
            "type": "template",
            "expression": "维基百科搜索 ${query}",
            "weight": 1,
            "default_args": { "lang": "zh", "limit": 10 },
            "examples": ["维基百科搜索 量子力学"]
          },
          {
            "type": "template", "expression": "维基百科 搜一下 ${query}", "weight": 1,
            "default_args": { "lang": "zh", "limit": 10 }, "examples": ["维基百科 搜一下 图灵机"]
          },
          {
            "type": "template",
            "expression": "wikipedia search for ${query}",
            "flags": "i",
            "weight": 1,
            "default_args": { "lang": "en", "limit": 10 },
            "examples": ["wikipedia search for quantum mechanics"]
          },
          {
            "type": "template", "expression": "wiki 搜索 ${query}", "weight": 1,
            "default_args": { "lang": "en", "limit": 10 }, "examples": ["wiki 搜索 rust"]
          }
        ],
        // 否决词：这些词出现说明用户在聊「搜索功能/搜索记录」，不是在让我搜
        "negative_patterns": ["正文|全文|页面内容|段落|搜索引擎|搜索功能|搜索框|搜索记录|搜索历史"],
        "arg_extractors": [
          {
            "regex": "(?:(?:搜索|搜一下|搜|查找|查一下|检索)(?:\\s+|[:：])|search\\s+for\\s+|search\\s*[:：])\\s*(\\S[\\s\\S]{0,60})$",
            "flags": "i",
            "arg": "query",
            "type": "string"
          }
        ]
      },
      "wikipedia.org.summary": {
        "priority": 10,
        "patterns": [
          {
            "type": "template",
            "expression": "维基百科词条 ${title}",
            "weight": 1,
            "default_args": { "lang": "zh" },
            "examples": ["维基百科词条 量子力学"]
          },
          {
            "type": "template", "expression": "维基百科条目：${title}", "weight": 1,
            "default_args": { "lang": "zh" }, "examples": ["维基百科条目：图灵机"]
          },
          {
            "type": "template",
            "expression": "wiki summary ${title}",
            "flags": "i",
            "weight": 1,
            "default_args": { "lang": "en" },
            "examples": ["wiki summary rust"]
          }
        ],
        // 「有哪些/多少/列出」这类是提问，不是在要摘要——必须挡住
        "negative_patterns": ["有哪些|哪些|多少|列出|列表|是什么|为什么|怎么|如何|区别|对比|数量|统计"],
        "arg_extractors": [
          {
            "regex": "(?:词条|条目|简介|摘要|导语|概述|summary)(?:\\s+|[:：])\\s*(\\S[\\s\\S]{0,50})$",
            "flags": "i",
            "arg": "title",
            "type": "string"
          }
        ]
      }
    },

    // ── weread.qq.com ────────────────────────────────────────────────────────
    "weread.qq.com": {
      "weread.qq.com.search": {
        "priority": 10,
        "patterns": [
          {
            "type": "template",
            "expression": "微信读书搜索 ${query}",
            "weight": 1,
            "default_args": { "limit": 20 },
            // 「微信读书搜索 原子习惯」这类含「习惯」的原文**会先被讨论态闸门拦掉**
            // （闸门为拦「这是我的归档习惯…」收了「习惯」一词），故不作正例——
            // 这是「宁漏勿误」的既定代价，代价是这类查询只能落回 LLM。
            "examples": ["微信读书搜索 人类简史"]
          },
          {
            "type": "template", "expression": "微信读书 搜一下 ${query}", "weight": 1,
            "default_args": { "limit": 20 }, "examples": ["微信读书 搜一下 三体"]
          },
          {
            "type": "template",
            "expression": "weread search for ${query}",
            "flags": "i",
            "weight": 1,
            "default_args": { "limit": 20 },
            "examples": ["weread search for atomic habits"]
          }
        ],
        // 带书名号的输入属于第 9 层「书内检索」计划，本层让路
        "negative_patterns": ["[《》「」]"],
        "arg_extractors": [
          {
            "regex": "(?:(?:搜索|搜一下|搜|查找|检索)(?:\\s+|[:：])|search\\s+for\\s+|search\\s*[:：])\\s*(\\S[\\s\\S]{0,40})$",
            "flags": "i",
            "arg": "query",
            "type": "string"
          }
        ]
      }
    },

    // ── news.ycombinator.com ─────────────────────────────────────────────────
    "news.ycombinator.com": {
      "news.ycombinator.com.search": {
        "priority": 10,
        "patterns": [
          {
            "type": "template",
            "expression": "hacker news search for ${query}",
            "flags": "i",
            "weight": 1,
            "default_args": { "limit": 20, "sort": "relevance" },
            "examples": ["hacker news search for rust"]
          },
          {
            "type": "template", "expression": "hn 搜一下 ${query}", "weight": 1,
            "default_args": { "limit": 20, "sort": "relevance" }, "examples": ["hn 搜一下 playwright"]
          }
        ],
        "arg_extractors": [
          {
            "regex": "(?:(?:搜索|搜一下|搜|查找|检索)(?:\\s+|[:：])|search\\s+for\\s+|search\\s*[:：])\\s*(\\S[\\s\\S]{0,60})$",
            "flags": "i",
            "arg": "query",
            "type": "string"
          }
        ]
      },
      "news.ycombinator.com.user": {
        "priority": 10,
        "patterns": [
          {
            "type": "template",
            "expression": "hacker news 用户 ${username}",
            "slot_validators": { "username": "[A-Za-z0-9_-]{1,30}" },
            "flags": "i",
            "weight": 1,
            "examples": ["hacker news 用户 pg"]
          },
          {
            "type": "template", "expression": "hn user ${username}", "slot_validators": { "username": "[A-Za-z0-9_-]{1,30}" }, "flags": "i", "weight": 1,
            "examples": ["hn user dang"]
          }
        ],
        "arg_extractors": [
          {
            "regex": "(?:用户|会员|user)\\s*[:：]?\\s*@?([A-Za-z0-9_-]{1,30})",
            "flags": "i",
            "arg": "username",
            "type": "string"
          }
        ]
      },
      "news.ycombinator.com.read": {
        "priority": 10,
        "patterns": [
          {
            "type": "template",
            // 必须有数字 id，故「hn 帖子」不会被认领（见负例集）
            "expression": "hacker news 帖子 ${id}",
            "slot_validators": { "id": "\\d{1,9}" },
            "flags": "i",
            "weight": 1,
            "default_args": { "limit": 20 },
            "examples": ["hacker news 帖子 123456"]
          },
          {
            "type": "template", "expression": "hn item ${id}", "slot_validators": { "id": "\\d{1,9}" }, "flags": "i", "weight": 1,
            "default_args": { "limit": 20 }, "examples": ["hn item 40000000"]
          },
          {
            "type": "template", "expression": "hn 帖子 ${id}", "slot_validators": { "id": "\\d{1,9}" }, "weight": 1,
            "default_args": { "limit": 20 }, "examples": ["hn 帖子 123456"]
          }
        ],
        "arg_extractors": [
          {
            "regex": "(?:帖子|主题|话题|item|story)\\s*[:#/]?\\s*(\\d{1,9})",
            "flags": "i",
            "arg": "id",
            "type": "integer",
            "min": 1
          }
        ]
      }
    }
  }
}
